{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VAP Receipt",
  "type": "object",
  "required": ["receipt_id", "action", "decision", "context", "proof"],
  "properties": {
    "receipt_id": { "type": "string" },
    "intent_id": { "type": "string", "description": "MGF D4: Unique cryptographically bound identifier for the specific action intent." },
    "parent_receipt_id": { "type": "string", "description": "Link to the original PERMIT receipt, enabling verifiable chaining to the SETTLEMENT receipt." },
    "execution_status": { 
      "type": "string", 
      "enum": ["permit_granted", "executing", "settlement_complete", "settlement_failed", "blocked"],
      "description": "Formal lifecycle state of the action."
    },
    "execution_deadline": { "type": "string", "format": "date-time", "description": "Maximum window allowed for execution before governance failure." },
    "timeout_handled": { "type": "boolean", "default": false, "description": "Flag to track if system has responded to an expired deadline." },
    "action": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": { "type": "string" },
        "target": { "type": "string" },
        "parameters": { "type": "object" },
        "metadata": { "type": "object" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": { "type": "string", "enum": ["allow", "block"] },
        "confidence": { "type": "number" }
      }
    },
    "context": {
      "type": "object",
      "required": ["policy_id", "timestamp"],
      "properties": {
        "policy_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "quality_scores": { "type": "object" },
    "cost": { "type": "object" },
    "proof": {
      "type": "object",
      "required": ["scheme", "signature", "signer_public_key", "merkle_root"],
      "properties": {
        "scheme": { "type": "string" },
        "signature": { "type": "string" },
        "pq_signature": { "type": "string" },
        "signer_public_key": { "type": "string" },
        "pq_public_key": { "type": "string" },
        "merkle_root": { "type": "string" },
        "merkle_path": { "type": "array", "items": { "type": "string" } },
        "anchors": { "type": "array" }
      }
    }
  }
}
